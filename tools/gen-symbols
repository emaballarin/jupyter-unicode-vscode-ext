#!/usr/bin/env python3
# The docstring is raw: it names LaTeX escapes like \underrightarrow, and `\u` not
# followed by four hex digits is a SyntaxError, not a warning.
r"""Regenerate data/symbols.json and data/jupyter.json from Julia's REPL symbol table.

Julia's latex_symbols.jl is the upstream source IPython derives its own table from, so
taking it directly gives us both sets from one parse: everything, and the identifier-safe
subset that is all Jupyter will complete.

The subset is computed by applying IPython's own rule, ("a" + char).isidentifier(), rather
than by copying IPython's output, with one exclusion of our own: format characters
(category Cf), which are invisible and which IPython's table never offers. That gives 1300
entries against their 1290, containing all of theirs with no disagreement in any value;
the ten extra (\bbpi, \^C, \underrightarrow, ...) are ones IPython's line-based parser
drops as an artefact rather than by intent. If that count ever changes, this is why it
was 1300 and not 1290.

That exclusion is why Julia's later \zwj (U+200D) is absent: it is legal in a name from
Python 3.13, but completing an invisible joiner into code is a trap, not a feature.

Both tables also drop any entry whose codepoint is still unassigned (category Cn). Julia
ships a few ahead of Unicode -- \_w, \_y, \_z, \_pgamma, unassigned through Unicode 17 --
and until a font can draw them they insert an empty box.

Both rules are only as fixed as the interpreter's Unicode database, as \zwj shows. Run
this on the Python the release workflow pins, or tools/check may disagree with it in CI.

Run by hand when the upstream file moves.
"""

import json
import re
import sys
import unicodedata
import urllib.request
from pathlib import Path

URL = "https://raw.githubusercontent.com/JuliaLang/julia/master/stdlib/REPL/src/latex_symbols.jl"

# A quoted Julia string. \U######## must come before \u####, and both before the general
# \<char> escape, or the shorter alternative wins and eats half a codepoint.
VALUE = r'"((?:\\U[0-9a-fA-F]{8}|\\u[0-9a-fA-F]{4}|\\[^uU]|[^"\\])+)"'

# `name = "\\bb"` at the top level: the font prefixes that pass 2 concatenates.
PREFIX = re.compile(r'^\s*(?:const\s+)?(\w+)\s*=\s*"([^"]*)"\s*$', re.M)

# `"\\alpha" => "α"`. Anchoring the key to a backslash is what skips the reverse-direction
# block further down the file, which maps the character back to the name.
DIRECT = re.compile(r'"(\\\\[^"]*)"\s*=>\s*' + VALUE)

# `blackboard*"R" => "ℝ"`, the font variants.
CONCAT = re.compile(r'(\w+)\*"([^"]*)"\s*=>\s*' + VALUE)


def unescape(s):
    """Resolve \\uXXXX and \\UXXXXXXXX.

    Not `unicode_escape`: it raises on the astral escapes in this file and mangles the
    non-ASCII literals sitting next to them, which are already decoded.
    """
    return re.sub(r"\\[uU]([0-9a-fA-F]{4,8})", lambda m: chr(int(m.group(1), 16)), s)


def identifier_safe(char):
    """Is the character legal inside a Python name, and not a format character (Cf)?

    Prefixed with a letter because several are legal to continue a name but not to start
    one, and IPython keeps those.
    """
    return ("a" + char).isidentifier() and all(unicodedata.category(c) != "Cf" for c in char)


def assigned(char):
    """Does every codepoint have a character behind it yet? Unassigned ones render as a box."""
    return all(unicodedata.category(c) != "Cn" for c in char)


def parse(source):
    # The leading #= ... =# block is the Julia script that generated the file. It is full
    # of things shaped like entries.
    body = re.sub(r"#=.*?=#", "", source, flags=re.S)
    prefixes = {name: value.replace("\\\\", "\\") for name, value in PREFIX.findall(source)}

    symbols = {}
    for name, char in DIRECT.findall(body):
        symbols[name.replace("\\\\", "\\")] = unescape(char)
    for prefix, suffix, char in CONCAT.findall(body):
        if prefix in prefixes:
            symbols[prefixes[prefix] + suffix] = unescape(char)
    return symbols


def main():
    here = Path(__file__).resolve().parent.parent
    print(f"Fetching {URL}", file=sys.stderr)
    with urllib.request.urlopen(URL, timeout=60) as response:
        source = response.read().decode("utf-8")

    symbols = {name: char for name, char in parse(source).items() if assigned(char)}
    if len(symbols) < 2000:
        sys.exit(f"only {len(symbols)} entries parsed; the upstream format has moved")

    jupyter = sorted(name for name, char in symbols.items() if identifier_safe(char))

    data = here / "data"
    # Four spaces, matching the rest of the repo: the generated files are read in diffs
    # like any other, and an indent that disagrees with the formatter rewrites every line
    # of both tables the next time either is touched.
    (data / "symbols.json").write_text(
        json.dumps(dict(sorted(symbols.items())), ensure_ascii=False, indent=4) + "\n",
        encoding="utf-8",
    )
    (data / "jupyter.json").write_text(
        json.dumps(jupyter, ensure_ascii=False, indent=4) + "\n", encoding="utf-8"
    )
    version = unicodedata.unidata_version
    print(f"{len(symbols)} symbols, {len(jupyter)} identifier-safe, Unicode {version}")


if __name__ == "__main__":
    main()
